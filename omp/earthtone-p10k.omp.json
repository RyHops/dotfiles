{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "base": "#2b2b2b",
    "crust": "#1e1e1e",
    "surface0": "#675951",
    "surface1": "#4a4540",
    "surface2": "#E5DCC7",
    "text": "#c8bfb0",
    "subtext0": "#a09888",
    "blue": "#5b7e99",
    "green": "#7a9a6a",
    "sage": "#80A798",
    "khaki": "#B1A079",
    "yellow": "#d4b07a",
    "peach": "#c49060",
    "red": "#a04050",
    "mauve": "#a07080",
    "pink": "#b88898",
    "teal": "#6a9e8a",
    "sky": "#7a9ab8",
    "lavender": "#8a8ea0",
    "flamingo": "#c4a088",
    "rosewater": "#ddd5c8"
  },
  "blocks": [
    {
      "alignment": "left",
      "type": "prompt",
      "newline": true,
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "\u256d\u2500\ue0b2",
          "foreground": "p:crust",
          "background": "p:surface2",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} "
        },
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:crust",
          "background": "p:lavender",
          "template": " {{ .UserName }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:crust",
          "background": "p:blue",
          "template": " \uf07c {{ .Path }} ",
          "properties": {
            "home_icon": "~",
            "style": "agnoster_short",
            "max_depth": 3
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:crust",
          "background": "p:khaki",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:khaki{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:khaki{{ end }}",
            "{{ if gt .Ahead 0 }}p:khaki{{ end }}",
            "{{ if gt .Behind 0 }}p:khaki{{ end }}"
          ],
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "properties": {
            "branch_icon": "\uf126 ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:crust",
          "background": "p:sage",
          "template": " \ue235 {{ if .Venv }}{{ .Venv }}{{ else }}{{ .Full }}{{ end }} ",
          "properties": {
            "display_mode": "context",
            "fetch_virtual_env": true
          }
        }
      ]
    },
    {
      "alignment": "right",
      "type": "prompt",
      "segments": [
        {
          "type": "node",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "p:crust",
          "background": "p:green",
          "template": " {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} \ue718 ",
          "properties": {
            "fetch_version": true,
            "display_mode": "files"
          }
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "p:crust",
          "background": "p:yellow",
          "template": " {{ .FormattedMs }} \uf252 ",
          "properties": {
            "threshold": 500
          }
        },
        {
          "type": "status",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "p:text",
          "background": "p:surface0",
          "background_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ],
          "template": " {{ if gt .Code 0 }}{{ reason .Code }}{{ else }}\uf42e{{ end }} ",
          "properties": {
            "always_enabled": true
          }
        },
        {
          "type": "time",
          "style": "diamond",
          "trailing_diamond": "\ue0b0\u2500\u256e",
          "invert_powerline": true,
          "foreground": "p:crust",
          "background": "p:surface2",
          "template": " {{ .CurrentDate | date .Format }} \uf017 ",
          "properties": {
            "time_format": "15:04:05"
          }
        }
      ]
    },
    {
      "alignment": "left",
      "type": "prompt",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:teal",
          "template": "\u2570\u2500\u276f"
        }
      ]
    }
  ],
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "final_space": true,
  "version": 4
}
